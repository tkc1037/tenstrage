---
/**
 * Footer — 運営者情報・編集方針・プライバシーへのリンク
 * Blueprint §5: 必須固定ページへの導線
 */
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <p class="footer-logo">TAKUZO TAXI</p>
      <p class="footer-tagline">東京タクシー転職ノート</p>
    </div>

    <nav class="footer-nav" aria-label="フッターナビゲーション">
      <ul class="footer-links">
        <li><a href="/about/">運営者情報</a></li>
        <li><a href="/editorial-policy/">編集方針</a></li>
        <li><a href="/privacy/">プライバシーポリシー</a></li>
        <li><a href="/contact/">お問い合わせ</a></li>
      </ul>
    </nav>

    <p class="footer-copy">
      <small>&copy; {currentYear} TAKUZO TAXI</small>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-section-gap);
    padding: 2.5rem var(--space-page-x) 2rem;
    background: var(--color-bg);
  }

  .footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
  }

  .footer-tagline {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.25rem;
  }

  .footer-links li {
    margin-bottom: 0;
  }

  .footer-links a {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.25rem 0;
    display: inline-block;
    min-height: var(--tap-min);
    line-height: var(--tap-min);
    transition: color var(--duration-fast) var(--easing-default);
  }

  .footer-links a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .footer-copy {
    margin-bottom: 0;
  }

  .footer-copy small {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }

    .footer-brand {
      flex-shrink: 0;
    }

    .footer-copy {
      flex-shrink: 0;
    }
  }
</style>
