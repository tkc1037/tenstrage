---
/**
 * ArticleCard — 記事カード
 * Blueprint §8.1: カード全体をリンク、タイトル3行、要約3-4行、16:9アイキャッチ
 */
interface Props {
  title: string;
  description: string;
  href: string;
  pubDate: Date;
  updatedDate?: Date;
  category?: string;
  heroImage?: string;
}

import { categoryLabels } from '../lib/categories';

const { title, description, href, pubDate, updatedDate, category, heroImage } = Astro.props;

const displayDate = updatedDate || pubDate;
---

<article class="card">
  <a href={href} class="card-link">
    {heroImage ? (
      <div class="card-image">
        <img src={heroImage} alt="" loading="lazy" width="640" height="360" />
      </div>
    ) : (
      <div class="card-image card-image-placeholder" aria-hidden="true">
        <span class="placeholder-icon">T</span>
      </div>
    )}
    <div class="card-content">
      {category && (
        <span class="card-category">{categoryLabels[category] || category}</span>
      )}
      <h3 class="card-title">{title}</h3>
      <p class="card-desc">{description}</p>
      <time class="card-date" datetime={displayDate.toISOString()}>
        {displayDate.toLocaleDateString('ja-JP')}
      </time>
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: box-shadow var(--duration-fast) var(--easing-default),
                border-color var(--duration-fast) var(--easing-default);
  }

  .card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: var(--color-ink);
  }

  .card-link:hover {
    color: var(--color-ink);
  }

  .card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-normal) var(--easing-default);
  }

  .card:hover .card-image img {
    transform: scale(1.03);
  }

  .card-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #F0EDE8, #E8E4DD);
  }

  .placeholder-icon {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-border);
    opacity: 0.5;
  }

  .card-content {
    padding: 1rem 1.25rem 1.25rem;
  }

  .card-category {
    display: inline-block;
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 0.375rem;
  }

  .card-title {
    font-size: var(--text-card-title);
    line-height: var(--leading-card-title);
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-desc {
    font-size: var(--text-card-summary);
    line-height: var(--leading-card-summary);
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-date {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }
</style>
