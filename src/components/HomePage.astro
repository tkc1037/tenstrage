---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from './ArticleCard.astro';
import AffiliateCta from './AffiliateCta.astro';
import DriversWorkBanner from './DriversWorkBanner.astro';
import CompareCta from './CompareCta.astro';
import HomeIcon from './HomeIcon.astro';
import type { HomeIconName } from './HomeIcon.astro';
import { getCollection } from 'astro:content';
import { categoryConfig } from '../lib/categories';
import { popularArticleSlugs, popularArticlesPeriod } from '../lib/popular';
interface Props { source?: 'tiktok' | 'instagram'; }
const { source } = Astro.props;
const articles = await getCollection('articles', ({ data }) => !data.draft);
const popularArticles = popularArticleSlugs
  .map((slug) => articles.find((article) => article.id === slug))
  .filter((article) => article !== undefined);
const entries: { number: string; icon: HomeIconName; title: string; desc: string; href: string; action: string }[] = [
  { number: '01', icon: 'company', title: '会社選びのポイントを知る', desc: '給与・配車アプリ・車両・事故補償。比べる前に、確認する条件を押さえる。', href: '/articles/taxi-company-selection-guide/', action: '選び方ガイドへ' },
  { number: '02', icon: 'qa', title: 'Q&Aで疑問を解消する', desc: '「免許代」「寮」「歩合」など、気になる言葉から短い回答を探す。', href: '/questions/', action: 'Q&Aを検索する' },
  { number: '03', icon: 'checklist', title: '転職の準備を進める', desc: '希望条件と面接で聞くことを整理して、応募までの流れをつかむ。', href: '/preparation/', action: '準備の確認リストへ' },
];
const topics: { label: string; icon: HomeIconName; href: string }[] = [
  { label: '寮・上京の費用', icon: 'housing', href: '/questions/#housing-cost' },
  { label: '入社祝い金の条件', icon: 'bonus', href: '/questions/#bonus-eligibility' },
  { label: '二種免許の費用', icon: 'license', href: '/questions/#license-cost' },
  { label: '給与保証の確認', icon: 'salary', href: '/questions/#salary-guarantee' },
  { label: '事故時の自己負担', icon: 'accident', href: '/questions/#accident-coverage' },
  { label: '相談登録後の連絡', icon: 'contact', href: '/questions/#service-flow' },
];
---
<BaseLayout title="" description="東京のタクシー転職で気になる会社選び・給与・寮・二種免許を、現役ドライバーの解説と検索できるQ&Aで確認。希望条件の整理から転職準備まで案内します。" canonicalUrl="https://takuzo-taxi.com/" noindex={Boolean(source)}>
  <section class="home-hero">
    <div class="hero-main">
      <div class="hero-copy">
        <p class="eyebrow">東京の現役タクシードライバーが案内</p>
        <h1>タクシー転職の疑問を、<br />一つずつクリアに。</h1>
        <p class="hero-lead">会社選びも、お金の不安も、応募の準備も。<br class="desktop-break" />今、知りたいことから始めましょう。</p>
        <a class="hero-compare" href="/compare/" data-compare-placement={source ? `start-${source}-hero` : 'home-hero'}>タクシー会社を条件で比較する <span aria-hidden="true">→</span></a>
      </div>
      <figure class="hero-photo">
        <img src="/images/takuzo-main-hero-768.webp" srcset="/images/takuzo-main-hero-768.webp 768w, /images/takuzo-main-hero-1200.webp 1200w, /images/takuzo-main-hero-1600.webp 1600w" sizes="(min-width: 72rem) 38rem, (min-width: 48rem) 55vw, 100vw" width="1200" height="675" alt="営業職からタクシーへ転職したTakuzo。営業職時代の年収454万円、転職1年目814万円という本人の実績" decoding="async" fetchpriority="high" />
        <figcaption class="hero-photo-note">画像の年収は運営者個人の実績です。同じ収入を保証するものではありません。</figcaption>
      </figure>
    </div>

    <CompareCta placement={source ? `start-${source}-feature` : 'home-feature'} />

    <p class="entry-heading">迷ったら、この順番で</p>
    <nav class="entry-grid" aria-label="目的から選ぶ">
      {entries.map((entry) => <a class="entry" href={entry.href}>
        <span class="entry-icon"><HomeIcon name={entry.icon} size={32} /></span>
        <span class="entry-number">STEP {entry.number}</span>
        <h2>{entry.title}</h2><p>{entry.desc}</p><span class="entry-action">{entry.action} <span aria-hidden="true">→</span></span>
      </a>)}
    </nav>
  </section>

  <AffiliateCta placement={source ? `start-${source}` : 'home-primary'} compact />

  <section class="home-topics">
    <div class="section-title"><h2>気になる条件から、Q&Aへ</h2><a href="/questions/">すべてのQ&A</a></div>
    <ul class="topic-grid">{topics.map((topic) => <li><a href={topic.href}>
      <span class="topic-icon"><HomeIcon name={topic.icon} /></span>
      <span class="topic-label">{topic.label}</span><span class="topic-arrow" aria-hidden="true">→</span>
    </a></li>)}</ul>
  </section>

  <section id="articles" class="home-articles">
    <h2>テーマから解説を読む</h2>
    <div class="category-grid">
      {Object.entries(categoryConfig).filter(([slug]) => slug !== 'company-selection').map(([slug, category]) =>
        <a href={`/category/${slug}/`}><span aria-hidden="true">{category.emoji}</span> {category.label}</a>
      )}
    </div>
    <div class="popular-title">
      <div>
        <h2>よく読まれている記事</h2>
        <p class="popular-note">{popularArticlesPeriod}の閲覧数が多い順です。</p>
      </div>
      <img class="popular-taxi" src="/images/home/takuzo-taxi-back-480.webp" width="480" height="286" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="article-grid">
      {popularArticles.map((article, index) => <ArticleCard title={article.data.title} description={article.data.description} href={`/articles/${article.id}/`} pubDate={article.data.pubDate} updatedDate={article.data.updatedDate} category={article.data.category} heroImage={article.data.heroImage} rank={index + 1} />)}
    </div>
    <p class="article-note">ほかの記事は、上のテーマから探せます。</p>
  </section>

  <DriversWorkBanner placement={source ? `start-${source}-banner` : 'home-banner'} />

  <section class="home-about">
    <div>
      <p class="eyebrow">運営者について</p>
      <h2>現場の経験と、<br />確認できる情報をもとに。</h2>
      <p>IT企業の営業職から、東京のタクシードライバーへ転職したTakuzoです。実体験と公開情報を分けて、会社選びや仕事の疑問をまとめています。</p>
      <a href="/about/">プロフィールを見る <span aria-hidden="true">→</span></a>
    </div>
    <div class="about-visual" role="img" aria-label="運営者タクゾーと、TAKUZO TAXIのイラスト">
      <img class="about-character" src="/images/home/takuzo-character-360.webp" srcset="/images/home/takuzo-character-360.webp 360w, /images/home/takuzo-character-640.webp 640w" sizes="(min-width: 48rem) 15rem, 46vw" width="360" height="572" alt="" loading="lazy" decoding="async" />
      <img class="about-taxi" src="/images/home/takuzo-taxi-front-480.webp" srcset="/images/home/takuzo-taxi-front-480.webp 480w, /images/home/takuzo-taxi-front-800.webp 800w" sizes="(min-width: 48rem) 19rem, 60vw" width="480" height="288" alt="" loading="lazy" decoding="async" />
      <p class="about-name" aria-hidden="true">運営者 <strong>タクゾー</strong></p>
    </div>
  </section>
</BaseLayout>
<style>
  .home-hero { padding-top: 2rem; }
  /* ファーストビューの比較表ボタン */
  .hero-compare { display: inline-flex; align-items: center; justify-content: center; gap: .4em; margin-top: 1.25rem; min-height: 3.25rem; padding: .75rem 1.5rem; background: var(--color-ink); color: var(--color-warm-paper); font-size: var(--text-button); font-weight: 700; text-decoration: none; border-radius: var(--radius-md); border-bottom: 4px solid var(--color-taxi-amber); }
  .hero-compare:hover { color: var(--color-taxi-amber); text-decoration: underline; }
  .hero-compare:focus-visible { outline: 3px solid var(--color-taxi-amber); outline-offset: 3px; }
  .hero-main { display: grid; gap: 1.5rem; }
  .eyebrow { font-size: var(--text-card-summary); font-weight: 700; margin-bottom: .75rem; }
  .home-hero h1 { margin: 0 0 1rem; line-height: 1.5; }
  .hero-lead { font-size: var(--text-lead); color: var(--color-text-muted); margin-bottom: 0; }
  .desktop-break { display: none; }

  /* ヒーロー画像：年収の実績。注記を必ず画像の直下に置く */
  .hero-photo { margin: 0; }
  .hero-photo img { width: 100%; height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .hero-photo-note { margin-top: .625rem; font-size: var(--text-caption); line-height: var(--leading-caption); color: var(--color-text-muted); }

  /* 運営者のイラスト：黄色い円の上にタクゾーとTAKUZO TAXI */
  .about-visual { position: relative; width: 100%; max-width: 26rem; aspect-ratio: 5 / 4; margin-inline: auto; overflow: hidden; border-radius: var(--radius-lg); background: var(--color-surface); border: 1px solid var(--color-border); }
  .about-visual::before { content: ""; position: absolute; width: 78%; aspect-ratio: 1; left: 50%; top: 10%; transform: translateX(-50%); border-radius: 50%; background: var(--color-taxi-amber); }
  .about-visual::after { content: ""; position: absolute; inset: auto 0 0; height: 12%; background: #E9E4D8; }
  .about-character { position: absolute; left: 6%; bottom: 0; height: 94%; width: auto; z-index: 1; }
  .about-taxi { position: absolute; right: 2%; bottom: 4%; width: 64%; height: auto; z-index: 2; }
  .about-name { position: absolute; top: .75rem; right: .75rem; z-index: 3; margin: 0; padding: .25rem .75rem; font-size: var(--text-caption); background: var(--color-ink); color: var(--color-warm-paper); border-radius: 999px; }
  .about-name strong { color: var(--color-taxi-amber); }

  /* 3ステップの流れ図 */
  .entry-heading { margin: 2.25rem 0 .75rem; font-weight: 700; font-size: var(--text-card-title); }
  .entry-grid { display: grid; gap: 1.5rem; }
  .entry { position: relative; display: grid; grid-template-columns: 3.5rem 1fr; gap: .25rem 1rem; padding: 1.25rem; color: var(--color-ink); background: var(--color-surface); border: 1px solid var(--color-border); border-top: 4px solid var(--color-accent); border-radius: var(--radius-md); text-decoration: none; }
  .entry:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .entry:not(:last-child)::after { content: "▼"; position: absolute; left: 50%; bottom: -1.45rem; transform: translateX(-50%); font-size: 1rem; line-height: 1; color: var(--color-taxi-amber); }
  .entry-icon { grid-row: 1 / 5; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; background: #FFF4D1; color: var(--color-ink); }
  .entry-number { font: 700 1rem/1.6 var(--font-mono); color: #7A5A00; }
  .entry h2 { font-size: var(--text-card-title); line-height: 1.6; margin: 0; }
  .entry p { font-size: var(--text-card-summary); color: var(--color-text-muted); margin: 0; }
  .entry-action { font-size: var(--text-card-summary); color: var(--color-link); font-weight: 700; }
  .entry:hover .entry-action { text-decoration: underline; }

  .section-title { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1rem; margin-top: var(--space-section-gap); margin-bottom: 1rem; }
  .section-title h2 { margin: 0; }
  .section-title > a { font-size: var(--text-card-summary); min-height: var(--tap-min); display: inline-flex; align-items: center; }
  .topic-grid { display: grid; gap: 0 1.5rem; list-style: none; padding: 0; }
  .topic-grid li { margin: 0; }
  .topic-grid a { display: flex; align-items: center; gap: .875rem; padding-block: .875rem; border-bottom: 1px solid var(--color-border); color: var(--color-ink); text-decoration: none; }
  .topic-grid a:hover { color: var(--color-link); }
  .topic-grid a:hover .topic-label { text-decoration: underline; }
  .topic-icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; flex: none; border-radius: var(--radius-md); background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-ink); }
  .topic-label { flex: 1; }

  .category-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .category-grid a { display: flex; gap: .5rem; align-items: center; padding: .75rem; min-height: var(--tap-min); font-size: var(--text-card-summary); text-decoration: none; color: var(--color-ink); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .category-grid a:hover { border-color: var(--color-ink); }

  .popular-title { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-top: var(--space-section-gap); margin-bottom: 1.25rem; }
  .popular-title h2 { margin: 0 0 .25rem; }
  .popular-note { margin: 0; font-size: var(--text-caption); color: var(--color-text-muted); }
  .popular-taxi { width: 8.5rem; height: auto; flex: none; }
  .article-grid { display: grid; gap: var(--space-card-gap); }
  .article-note { font-size: var(--text-caption); color: var(--color-text-muted); margin-top: 1rem; }

  .home-about { display: grid; gap: 1.5rem; margin-top: var(--space-section-gap); padding-block: 2rem; border-top: 1px solid var(--color-border); }
  .home-about h2 { margin: 0 0 1rem; }

  @media (min-width: 48rem) {
    .home-hero { padding-top: 3rem; }
    .hero-main { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); align-items: center; gap: 2.5rem; }
    .desktop-break { display: initial; }
    .entry-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
    .entry { grid-template-columns: 1fr; grid-template-rows: auto auto auto 1fr auto; padding: 1.5rem; }
    .entry:not(:last-child)::after { content: "▶"; left: auto; right: -1.55rem; top: 50%; bottom: auto; transform: translateY(-50%); }
    .entry-icon { grid-row: auto; margin-bottom: .5rem; }
    .entry-action { margin-top: .75rem; }
    .topic-grid, .article-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .category-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .popular-taxi { width: 12rem; }
    .home-about { grid-template-columns: 1fr 1fr; align-items: center; gap: 2rem; }
  }
</style>
