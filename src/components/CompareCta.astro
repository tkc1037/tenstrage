---
// 会社比較表（/compare/）への入口。feature＝大型ブロック、bar＝記事・カテゴリ冒頭の帯。
import comparisonSource from '../lib/taxi-comparison.js?raw';
interface Props { placement: string; variant?: 'feature' | 'bar'; }
const { placement, variant = 'feature' } = Astro.props;
// 掲載社数は比較表のデータから数える。数えられなければ社数を出さない。
const companyCount = new Set(comparisonSource.match(/name:'[^']+'/g) ?? []).size;
const points = ['歩合率', '給与保証', '入社支援金', '寮', '二種免許費用', '配車アプリ'];
---
{variant === 'bar' ? (
  <a class="compare-bar" href="/compare/" data-compare-placement={placement}>
    <span class="bar-icon" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 10h18M9 4v16M15 4v16" /></svg>
    </span>
    <span class="bar-text">
      <strong>{companyCount > 0 ? `東京のタクシー会社${companyCount}社を条件で比較` : '東京のタクシー会社を条件で比較'}</strong>
      <span>歩合率・寮・入社支援金を1つの表で確認</span>
    </span>
    <span class="bar-arrow" aria-hidden="true">→</span>
  </a>
) : (
  <aside class="compare-feature" aria-label="タクシー会社比較表の案内" data-compare-placement={placement}>
    <div class="feature-copy">
      <p class="feature-eyebrow">TAKUZOの会社比較表</p>
      <p class="feature-title">
        {companyCount > 0
          ? <>東京のタクシー会社<br /><span class="feature-count">{companyCount}</span>社を、条件で比べる。</>
          : <>東京のタクシー会社を、<br />条件で比べる。</>}
      </p>
      <p class="feature-lead">求人サイトを1社ずつ見比べなくても大丈夫。現役ドライバーのタクゾーが、公開求人の条件を1つの表にまとめました。気になる会社は最大4社まで横並びで比べられます。</p>
      <ul class="feature-points" aria-label="比べられる条件">
        {points.map((point) => <li>{point}</li>)}
      </ul>
      <a class="feature-button" href="/compare/">タクシー会社を条件で比較する <span aria-hidden="true">→</span></a>
      <p class="feature-meta">未経験向け・東京23区／三鷹・武蔵野</p>
    </div>
    <div class="feature-visual" aria-hidden="true">
      <div class="mock-row mock-head"><span></span><span></span><span></span><span></span></div>
      <div class="mock-row"><span></span><span class="hit"></span><span></span><span></span></div>
      <div class="mock-row picked"><span></span><span class="hit"></span><span class="hit"></span><span></span></div>
      <div class="mock-row"><span></span><span></span><span class="hit"></span><span></span></div>
      <div class="mock-row"><span></span><span class="hit"></span><span></span><span class="hit"></span></div>
    </div>
  </aside>
)}
<style>
  /* 帯：記事・カテゴリの冒頭。濃い地にタクシーの琥珀色で、本文の中でも目に入る */
  .compare-bar { display: flex; align-items: center; gap: .875rem; margin-block: 1.5rem; padding: 1rem 1.125rem; min-height: var(--tap-min); background: var(--color-ink); color: var(--color-warm-paper); border-radius: var(--radius-md); border-left: 6px solid var(--color-taxi-amber); text-decoration: none; box-shadow: var(--shadow-md); transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease; }
  .compare-bar:hover { color: var(--color-warm-paper); transform: translateY(-1px); box-shadow: var(--shadow-lg); }
  .compare-bar:focus-visible { outline: 3px solid var(--color-taxi-amber); outline-offset: 3px; }
  .bar-icon { display: grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: var(--radius-sm); background: var(--color-taxi-amber); color: var(--color-ink); }
  .bar-text { flex: 1; display: grid; gap: .125rem; }
  .bar-text strong { font-size: var(--text-card-title); line-height: 1.5; }
  .bar-text span { font-size: var(--text-caption); line-height: 1.5; color: #D9D4C9; }
  .bar-arrow { flex: none; font-size: 1.5rem; font-weight: 700; color: var(--color-taxi-amber); }
  .compare-bar:hover .bar-text strong { text-decoration: underline; }

  /* 大型ブロック：トップと記事末尾 */
  .compare-feature { display: grid; gap: 1.5rem; margin-block: 2rem; padding: 1.75rem 1.25rem; background: var(--color-ink); color: var(--color-warm-paper); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); overflow: hidden; position: relative; }
  .compare-feature::before { content: ""; position: absolute; inset: 0 0 auto; height: 6px; background: repeating-linear-gradient(90deg, var(--color-taxi-amber) 0 1.25rem, var(--color-ink) 1.25rem 2.5rem); }
  .feature-eyebrow { margin: 0 0 .5rem; font-size: var(--text-caption); font-weight: 700; letter-spacing: .08em; color: var(--color-taxi-amber); }
  .feature-title { margin: 0 0 1rem; font-size: var(--text-h2); line-height: 1.5; font-weight: 700; }
  .feature-count { font: 700 1.45em/1 var(--font-heading); color: var(--color-taxi-amber); margin-right: .05em; }
  .feature-lead { margin: 0 0 1.25rem; font-size: var(--text-card-summary); line-height: 1.85; color: #E4DFD4; }
  .feature-points { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 1.5rem; padding: 0; list-style: none; }
  .feature-points li { margin: 0; padding: .3rem .75rem; font-size: var(--text-caption); font-weight: 700; border: 1px solid rgba(244, 176, 0, .55); border-radius: 999px; color: var(--color-warm-paper); }
  .feature-button { display: flex; justify-content: center; align-items: center; gap: .4em; width: 100%; min-height: 3.5rem; padding: .875rem 1rem; background: var(--color-taxi-amber); color: var(--color-ink); font-size: var(--text-button); font-weight: 700; white-space: nowrap; text-decoration: none; border-radius: var(--radius-md); box-shadow: 0 4px 0 #B88400; transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease; }
  .feature-button:hover { color: var(--color-ink); transform: translateY(2px); box-shadow: 0 2px 0 #B88400; text-decoration: underline; }
  .feature-button:focus-visible { outline: 3px solid var(--color-warm-paper); outline-offset: 3px; }
  .feature-meta { margin: .875rem 0 0; font-size: var(--text-caption); color: #BDB7AB; }

  /* 比較表の雰囲気だけを示す飾り。数値は出さない */
  .feature-visual { display: none; gap: .4rem; padding: .875rem; background: rgba(247, 244, 237, .06); border: 1px solid rgba(247, 244, 237, .14); border-radius: var(--radius-md); }
  .mock-row { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: .4rem; }
  .mock-row span { height: .9rem; border-radius: 3px; background: rgba(247, 244, 237, .16); }
  .mock-head span { background: rgba(247, 244, 237, .32); }
  .mock-row .hit { background: var(--color-taxi-amber); }
  .mock-row.picked { outline: 2px solid var(--color-taxi-amber); outline-offset: 3px; border-radius: 3px; }

  @media (min-width: 48rem) {
    .compare-feature { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: center; gap: 2rem; padding: 2.25rem 2rem; }
    .feature-button { width: fit-content; padding-inline: 2rem; font-size: 1.1875rem; }
    .feature-visual { display: grid; padding: 1.25rem; gap: .6rem; }
    .mock-row span { height: 1.1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .compare-bar, .feature-button { transition: none; }
    .compare-bar:hover, .feature-button:hover { transform: none; }
  }
</style>
