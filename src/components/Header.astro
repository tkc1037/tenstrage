---
interface Props { currentPath?: string; }
const { currentPath = Astro.url.pathname } = Astro.props;
const navItems = [
  { label: '会社選び', href: '/articles/taxi-company-selection-guide/' },
  { label: 'Q&A', href: '/questions/' },
  { label: '転職準備', href: '/preparation/' },
  { label: '記事を読む', href: '/#articles' },
];
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo" aria-label="TAKUZO TAXI トップページ">TAKUZO TAXI</a>
    <div class="header-actions">
      <a class="search-link" href="/questions/#question-query" aria-label="Q&Aを検索する">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="7" /><path d="m15 15 6 6" /></svg>
      </a>
      <button type="button" class="menu-button" aria-controls="site-nav" aria-expanded="false" hidden>メニュー</button>
    </div>
    <nav id="site-nav" class="site-nav" aria-label="メインナビゲーション">
      <ul>{navItems.map(({ label, href }) => <li><a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a></li>)}</ul>
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button')!;
  const nav = document.querySelector<HTMLElement>('#site-nav')!;
  const desktop = window.matchMedia('(min-width: 48rem)');
  function setOpen(open: boolean) {
    button.setAttribute('aria-expanded', String(open));
    button.textContent = open ? '閉じる' : 'メニュー';
    nav.hidden = !open;
  }
  function syncViewport() {
    const hadFocus = nav.contains(document.activeElement);
    button.hidden = desktop.matches;
    setOpen(desktop.matches);
    if (!desktop.matches && hadFocus) button.focus();
  }
  button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !desktop.matches && !nav.hidden) { setOpen(false); button.focus(); }
  });
  nav.addEventListener('click', (event) => {
    if (!desktop.matches && (event.target as Element).closest('a')) { setOpen(false); button.focus(); }
  });
  desktop.addEventListener('change', syncViewport);
  syncViewport();
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
  .header-inner { max-width: 72rem; margin: 0 auto; padding: .5rem var(--space-page-x); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; min-height: var(--header-height); gap: .25rem 1rem; }
  .header-logo { color: var(--color-ink); text-decoration: none; font: 700 1.125rem/1.5 var(--font-heading); letter-spacing: .04em; }
  .header-actions { display: flex; gap: .5rem; align-items: center; }
  .search-link, .menu-button { display: inline-flex; justify-content: center; align-items: center; min-width: var(--tap-min); min-height: var(--tap-min); color: var(--color-ink); border-radius: var(--radius-sm); }
  .menu-button { font: inherit; font-size: var(--text-card-summary); padding: .5rem; background: var(--color-surface); border: 1px solid var(--color-border); cursor: pointer; }
  .search-link:hover, .menu-button:hover { background: var(--color-surface); }
  .site-nav { flex-basis: 100%; }
  .site-nav ul { margin: 0; padding: .5rem 0; list-style: none; }
  .site-nav li { margin: 0; }
  .site-nav a { display: flex; align-items: center; min-height: var(--tap-min); padding: .65rem .75rem; color: var(--color-ink); text-decoration: none; font-size: var(--text-card-summary); border-radius: var(--radius-sm); }
  .site-nav a:hover { text-decoration: underline; background: var(--color-surface); }
  .site-nav a[aria-current="page"] { background: #FBE7B3; font-weight: 700; }
  [hidden] { display: none !important; }
  @media (min-width: 48rem) {
    .site-nav { flex-basis: auto; margin-left: auto; }
    .site-nav ul { display: flex; gap: .25rem; padding: 0; }
    .header-actions { order: 2; }
  }
</style>
