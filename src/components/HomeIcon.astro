---
/** トップページの入口・Q&Aに添える線画アイコン（装飾。読み上げ対象外） */
export type HomeIconName = 'company' | 'qa' | 'checklist' | 'housing' | 'bonus' | 'license' | 'salary' | 'accident' | 'contact';
interface Props { name: HomeIconName; size?: number; }
const { name, size = 28 } = Astro.props;
---
<svg class="home-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'company' && <><path d="M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16" /><path d="M15 9h4a1 1 0 0 1 1 1v11" /><path d="M3 21h18" /><path d="M8 8h3M8 12h3M8 16h3" /></>}
  {name === 'qa' && <><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" /><path d="M9.8 9.6a2.3 2.3 0 1 1 3.3 2.1c-.7.3-1.1.9-1.1 1.6v.3" /><path d="M12 16.6h.01" /></>}
  {name === 'checklist' && <><rect x="5" y="3.5" width="14" height="17.5" rx="2" /><path d="M9 3.5h6v2.5H9z" /><path d="m8.5 11 1.5 1.5 3-3" /><path d="m8.5 16.5 1.5 1.5 3-3" /></>}
  {name === 'housing' && <><path d="M3 11.5 12 4l9 7.5" /><path d="M5.5 10v10h13V10" /><path d="M10 20v-5.5h4V20" /></>}
  {name === 'bonus' && <><rect x="3" y="8" width="18" height="4.5" rx="1" /><path d="M5 12.5V21h14v-8.5" /><path d="M12 8v13" /><path d="M12 8C10.5 5 7 4.5 7 6.5S10 8 12 8c2 0 5 .5 5-1.5S13.5 5 12 8z" /></>}
  {name === 'license' && <><rect x="2.5" y="5" width="19" height="14" rx="2" /><circle cx="8.5" cy="10.8" r="2" /><path d="M5.3 16c.6-1.4 1.8-2.1 3.2-2.1s2.6.7 3.2 2.1" /><path d="M14.5 10h4M14.5 13.5h4" /></>}
  {name === 'salary' && <><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6z" /><path d="m9.5 8 2.5 3.2L14.5 8" /><path d="M12 11.2V16.5M9.6 12.8h4.8M9.6 14.8h4.8" /></>}
  {name === 'accident' && <><path d="M12 3.5 2.5 20h19z" /><path d="M12 9.5v5" /><path d="M12 17.3h.01" /></>}
  {name === 'contact' && <><path d="M5 4h3l1.5 4.5L7.5 10a11 11 0 0 0 6.5 6.5l1.5-2 4.5 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></>}
</svg>
<style>
  .home-icon { flex: none; }
</style>
